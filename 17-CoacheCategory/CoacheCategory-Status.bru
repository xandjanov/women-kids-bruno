meta {
  name: CoacheCategory Status
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/coache-categories/{{coacheCategoryId}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "status": false
  }
}

docs {
  Global status funksiyasi. false yozuvni public ro'yxatdan yashiradi,
  true qayta ko'rsatadi. `status` majburiy, yozuv topilmasa 404.

  Bu jadvalda `sort-order` endpointi YO'Q — `sort_order` ustuni mavjud emas.
}
