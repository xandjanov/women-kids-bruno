meta {
  name: Pages Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/pages/create
  body: multipartForm
  auth: inherit
}

headers {
  Accept-Language: oz
}

body:multipart-form {
  key: about-us
  title_oz: Biz haqimizda
  title_ru: О нас
  title_uz: Биз ҳақимизда
  title_en: About us
  short_content_oz: Tashkilot haqida qisqa malumot
  short_content_ru: Краткая информация об организации
  short_content_uz: Ташкилот ҳақида қисқа маълумот
  short_content_en: Short info about the organization
  content_oz: <p>Toliq matn.</p>
  content_ru: <p>Полный текст.</p>
  content_uz: <p>Тўлиқ матн.</p>
  content_en: <p>Full text.</p>
  options: 
  status: true
  ~files: @file(_samples/sample.png)
  ~lang: oz
}

docs {
  multipart/form-data.

  MAJBURIY: key (max 155) - sahifaning unikal kaliti (masalan: about-us, contacts).
  Takrorlansa 409 qaytadi.

  Qolgan maydonlar ixtiyoriy.
  files - rasm (jpg/jpeg/png/webp), har biri max 5MB, 100 tagacha.
  lang  - har bir faylga til (oz|ru|uz|en|all), FAYL SONI BILAN TENG bolishi shart.
  options - ixtiyoriy qoshimcha maydon (max 255).
}
