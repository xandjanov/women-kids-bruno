meta {
  name: OnboardingStep Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/onboarding-steps/update/{{onboardingStepId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "title_oz": "Ariza qoldiring",
    "title_ru": "Оставьте заявку",
    "title_uz": "Ариза қолдиринг",
    "title_en": "Submit an application",
    "short_content_oz": "Sizga qulay vaqtda bog'lanishimiz uchun ma'lumotlaringizni yuboring.",
    "short_content_ru": "Отправьте свои данные, чтобы мы связались с вами в удобное время.",
    "short_content_uz": "Сизга қулай вақтда боғланишимиз учун маълумотларингизни юборинг.",
    "short_content_en": "Send your details so we can contact you at a convenient time.",
    "sort_order": 1,
    "status": true
  }
}

docs {
  Qisman yangilash: faqat yuborilgan maydonlar o'zgaradi.
  `title_oz/ru/uz/en` maksimum 255 belgi, `short_content_oz/ru/uz/en` text.
  Bo'sh satr maydonni tozalaydi, false va 0 ham saqlanadi.
  Yozuv topilmasa tarjimali 404 qaytadi.
}
