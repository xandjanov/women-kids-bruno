meta {
  name: Feedback Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/feedback/detail/{{feedbackId}}
  body: none
  auth: inherit
}

headers {
  Accept-Language: oz
}

docs {
  To'liq murojaat: `id`, `branch_id`, `branch_title`, `full_name`, `email`,
  `phone`, `message`, `created_at`.

  `branch_title` `Accept-Language` bo'yicha keladi (oz | ru | uz | en).
  Topilmasa 404, id raqam bo'lmasa 400.

  Ruxsat: `admin` va `superadmin`.
}
