meta {
  name: Menu Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/menu/create
  body: multipartForm
  auth: inherit
}

headers {
  Accept-Language: oz
}

body:multipart-form {
  cat_id: 0
  title_oz: Biz haqimizda
  title_ru: О нас
  title_uz: Биз ҳақимизда
  title_en: About us
  short_content_oz: Menyu uchun qisqa matn
  short_content_ru: Короткий текст для меню
  short_content_uz: Меню учун қисқа матн
  short_content_en: Short text for the menu
  content_oz: <p>Menyu toliq matni.</p>
  content_ru: <p>Полный текст меню.</p>
  content_uz: <p>Меню тўлиқ матни.</p>
  content_en: <p>Full menu text.</p>
  address_oz: Toshkent sh., Amir Temur ko'chasi 1
  address_ru: г. Ташкент, улица Амира Темура 1
  address_uz: Тошкент ш., Амир Темур кўчаси 1
  address_en: Tashkent, Amir Temur street 1
  inner_link: /about-us
  external_link: 
  link: https://menu.example.uz
  meta_title_oz: Biz haqimizda
  meta_title_ru: О нас
  meta_title_uz: Биз ҳақимизда
  meta_title_en: About us
  meta_description_oz: Biz haqimizda sahifasi
  meta_description_ru: Страница о нас
  meta_description_uz: Биз ҳақимизда саҳифаси
  meta_description_en: About us page
  meta_keywords_oz: biz, haqimizda
  meta_keywords_ru: о нас, компания
  meta_keywords_uz: биз, ҳақимизда
  meta_keywords_en: about, us
  slug: biz-haqimizda
  sort_order: 0
  status: true
  ~files: @file(_samples/sample.png)
  ~lang: oz
}

docs {
  multipart/form-data. `CreateMenuDto` dagi HAMMA maydon yozilgan.

  | Maydon guruhi | Cheklov |
  |---|---|
  | `title_oz/ru/uz/en` | max 255 |
  | `short_content_oz/ru/uz/en` | cheklovsiz (text) |
  | `content_oz/ru/uz/en` | cheklovsiz (text) |
  | `address_oz/ru/uz/en` | max 255 |
  | `meta_title_oz/ru/uz/en` | cheklovsiz |
  | `meta_description_oz/ru/uz/en` | cheklovsiz |
  | `meta_keywords_oz/ru/uz/en` | cheklovsiz |
  | `inner_link`, `external_link` | max 255 |
  | `link` | cheklovsiz (text) |
  | `slug` | max 255 — bo'sh bo'lsa title'dan yasaladi |
  | `cat_id` | ota menyu ID; `0`/bo'sh = ildiz. Yo'q ID -> 400 |
  | `sort_order` | int, standart 0 |
  | `status` | bool, standart true |
  | `files` | rasm/mp4, `lang` fayl soniga teng bo'lishi shart |

  Public javobda har guruh `Accept-Language` bo'yicha bittaga aylanadi:
  `title`, `short_content`, `content`, `address`, `meta_title`,
  `meta_description`, `meta_keywords`.
}
