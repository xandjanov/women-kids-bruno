meta {
  name: Menu Sort Order
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/menu/sort-order
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "sort_order": [3, 1, 2]
  }
}

docs {
  Menyularni qayta tartiblash. Massivdagi ID'lar yangi tartibda beriladi.

  - takroriy ID bo'lsa 400
  - mavjud bo'lmagan ID bo'lsa 404
  - massiv bo'sh bo'lmasligi kerak (min 1)
}
