meta {
  name: Staff Update
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/admin/staffs/update/{{staffId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "username": "redactor1",
    "email": "redactor1.new@wk.local",
    "password": "NewPass@123",
    "role": "admin",
    "status": true
  }
}

docs {
  Qisman yangilash — faqat yuborilgan maydonlar o'zgaradi, barchasi ixtiyoriy.

  Diqqat: `role` yoki `status`ni O'ZINGIZGA o'zgartirsangiz 403 qaytadi.
  `password` o'zgarsa yoki `status: false` bo'lsa — shu staff'ning hamma sessiyasi o'chadi.
}
