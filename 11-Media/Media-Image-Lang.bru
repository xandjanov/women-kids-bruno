meta {
  name: Media Image Lang
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/{{table}}/image/{{recordId}}/lang/{{fileId}}?lang=oz
  body: none
  auth: inherit
}

params:query {
  lang: oz
}

headers {
  Accept-Language: oz
}

docs {
  Mavjud faylning tilini o'zgartiradi. Til QUERY parametrda beriladi (body yo'q).

  lang: oz | ru | uz | en | all
        all yoki bo'sh = barcha tillarda ko'rinadi.

  Noto'g'ri til - 400, fayl topilmasa - 404.
}
