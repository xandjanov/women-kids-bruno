meta {
  name: Coache Sort Order
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/coaches/sort-order
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "sort_order": [{{coacheId}}]
  }
}

docs {
  Global yozuvlar tartiblash funksiyasi.
  Bir nechta mavjud IDni kerakli tartibda yuboring, masalan [3, 1, 2].
  Tanlanmagan yozuvlar o'z o'rnida qoladi. Bitta ID tartibni o'zgartirmaydi.
  Takroriy ID 400, mavjud bo'lmagan ID 404 qaytaradi.

  Tartiblash guruhdan qat'i nazar ishlaydi — `sort_order` global maydon.
}
