meta {
  name: Social Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/socials/update/{{socialId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "title_oz": "Telegram kanal",
    "title_ru": "Telegram канал",
    "title_uz": "Телеграм канал",
    "title_en": "Telegram channel",
    "short_content_oz": "Kundalik jadval va chegirmalar e'loni.",
    "short_content_ru": "Ежедневное расписание и анонсы скидок.",
    "short_content_uz": "Кундалик жадвал ва чегирмалар эълони.",
    "short_content_en": "Daily schedule and discount announcements.",
    "icon": "telegram",
    "options": "header",
    "link": "https://t.me/example_new",
    "sort_order": 1,
    "status": true
  }
}

docs {
  Qisman yangilash — faqat yuborilgan maydonlar o'zgaradi, qolgani joyida qoladi.
  Create ham, update ham JSON.

  Maydonlar va cheklovlar `Social Create` bilan bir xil.
  Bo'sh satr (`""`) yuborilsa maydon bo'shatiladi — yuborilmasa tegilmaydi.
  Yozuv topilmasa tarjimali 404, id raqam bo'lmasa 400.
}
