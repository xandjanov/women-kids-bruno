meta {
  name: Status Update
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/v1/{{table}}/{{recordId}}/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept-Language: oz
}

body:json {
  {
    "status": true
  }
}

docs {
  Har qanday yozuvning status (ko'rinadi / ko'rinmaydi) holatini o'zgartiradi.

  Ruxsat etilgan table:
    pages | socials | menu | features | metrics | coaches | coache-categories | directions | trial-benefits | advantages | onboarding-steps | branches | trial-offers | usefuls

  `status` majburiy. Yozuv topilmasa 404, table ruxsat etilmagan bo'lsa 404.
}
